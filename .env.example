# Orpheus-FastAPI Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# LMStudio / API Connection Settings
# ============================================================================

# URL for the LMStudio or OpenAI-compatible API endpoint
# For LMStudio, this is typically http://127.0.0.1:1234/v1/completions
ORPHEUS_API_URL=http://127.0.0.1:1234/v1/completions

# Request timeout in seconds (increase for longer generations)
ORPHEUS_API_TIMEOUT=120

# Model name to use (leave empty to use whatever model is loaded in LMStudio)
# Example GGUF model names:
#   - Orpheus-3b-FT-Q8_0.gguf
#   - Orpheus-3b-FT-Q4_K_M.gguf
#   - Orpheus-3b-FT-Q2_K.gguf
# Any Orpheus GGUF model loaded in LMStudio will work
ORPHEUS_MODEL_NAME=

# ============================================================================
# Generation Parameters
# ============================================================================

# Maximum tokens for generation (higher = longer audio output)
ORPHEUS_MAX_TOKENS=8192

# Temperature for generation (higher = more varied/expressive)
ORPHEUS_TEMPERATURE=0.6

# Top-p sampling parameter (nucleus sampling)
ORPHEUS_TOP_P=0.9

# Sample rate for audio output (24kHz is standard for Orpheus)
ORPHEUS_SAMPLE_RATE=24000

# ============================================================================
# Server Settings
# ============================================================================

# Port for the FastAPI server
ORPHEUS_PORT=5005

# Host address (0.0.0.0 = accessible from network)
ORPHEUS_HOST=0.0.0.0

# ============================================================================
# Notes
# ============================================================================
#
# Repetition penalty is hardcoded to 1.1 for stability (model constraint)
#
# Available voices (in order of conversational realism):
#   English: tara, leah, jess, leo, dan, mia, zac, zoe
#   French: pierre, amelie, marie
#   German: jana, thomas, max
#   Korean: 유나, 준서
#   Hindi: ऋतिका
#   Mandarin: 长乐, 白芷
#   Spanish: javi, sergio, maria
#   Italian: pietro, giulia, carlo
#
# Available emotion tags:
#   <laugh>, <chuckle>, <sigh>, <cough>, <sniffle>, <groan>, <yawn>, <gasp>
#
